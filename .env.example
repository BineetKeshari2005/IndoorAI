# ==============================================================================
# IndoorAI - Environment Configuration Template
# Copy this file to .env and adjust values for your local environment
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
APP_NAME=IndoorAI
API_V1_PREFIX=/api/v1

# Security & Authentication
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY=change-this-to-a-very-secure-random-32-byte-hex-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Device Registration & Authorization
REQUIRE_DEVICE_REGISTRATION=True
MAX_UNAUTHORIZED_PROBE_REQUESTS_PER_MINUTE=10

# Database Configuration (PostgreSQL + SQLAlchemy)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=indoorai_user
POSTGRES_PASSWORD=indoorai_password
POSTGRES_DB=indoorai_db
DATABASE_URL=postgresql+asyncpg://indoorai_user:indoorai_password@localhost:5432/indoorai_db

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=indoorai-multimodal-localization
MLFLOW_ARTIFACT_ROOT=./experiments/mlflow_artifacts

# Data & Storage Paths
DATA_DIR=./data
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
EXTERNAL_DATA_PATH=./data/external
MODEL_CHECKPOINT_DIR=./experiments/checkpoints

# Computer Vision & Image Uploads
UPLOAD_STORAGE_PATH=./data/raw/uploads
MAX_UPLOAD_SIZE_MB=15
ALLOWED_IMAGE_EXTENSIONS=["jpg", "jpeg", "png", "webp"]
ENABLE_AUTOMATIC_FACE_BLURRING=True
STRIP_IMAGE_EXIF=True

# Sensor Fusion & Inference Settings
DEFAULT_PREDICTION_CONFIDENCE_THRESHOLD=0.65
EKF_PROCESS_NOISE=0.05
PARTICLE_FILTER_NUM_PARTICLES=500

